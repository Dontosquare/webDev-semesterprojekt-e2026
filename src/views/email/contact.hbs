<!DOCTYPE html>
<html lang="da">
<head><meta charset="UTF-8"><title>Ny kontaktbesked</title></head>
<body style="font-family:Arial,sans-serif;background:#f3f4f6;padding:24px">
  <div style="max-width:600px;margin:auto;background:white;padding:28px;border-radius:10px">
    <h2>Ny kontaktbesked</h2>
    <p><strong>Navn:</strong> {{name}}</p>
    <p><strong>E-mail:</strong> {{email}}</p>
    <h3>Besked:</h3>
    <p style="white-space:pre-wrap">{{message}}</p>
    <hr><small>Sendt fra hjemmesidens kontaktformular.</small>
  </div>
</body>
</html>