<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
</head>

<body>
    <main>
        <header>
            <nav class="nav">
                <div class="logo-container">
                    <a href="/">
                        <img src="/images/logotext.webp" alt="Gamecreators Logo" class="logo">
                    </a>
                </div>
                <form action="search" method="GET" class="header__input__container">
                    <input class="header__input" type="search" placeholder="Søg.." name="q">
                </form>
                <div class="nav-link-container">
                    <a class="nav-link" href="/products">
                        <p>Produkter</p>
                    </a>
                    <a class="nav-link" href="/contact">
                        <p>Kontakt</p>
                    </a>
                    <a class="nav-link" href="/basket">
                        <p>Kurv</p>
                    </a>
                    <a class="nav-link" onclick="openPopup()">
                        <p>Login/Opret</p>
                    </a>
                </div>
            </nav>
        </header>

        <!-- Login popup -->
        <div id="loginPopup" class="popup">
            <div class="popup-content">
                <h1>Login?</h1>
                <button class="close-button" onclick="closePopup()">Luk</button>
            </div>
        </div>
    </main>

    <script>
        let loginPopup = document.getElementById('loginPopup');
        loginPopup.style.display = 'none';

        function openPopup() {
            loginPopup.style.display = 'flex';
        }

        function closePopup() {
            loginPopup.style.display = 'none';
        }
    </script>

</body>

</html>