{{> header}}
<div class="title">
    <h1>Alle produkter</h1>
</div>

<div class="products-container">
    {{#each products}}
    <div class="product-card">
        <div class="card-image">
            <!-- Change path for src -->
            <img src="/images/products/test-image.jpg" alt="{{name}}">
        </div>
        <div class="card-price">
            <p>{{price}}.- DKK</p>
        </div>
        <div class="card-description">
            <p>{{name}}</p>
            <p>{{description}}</p>
        </div>

        <div class="card-footer">
            <div class="stock-status">
                <!-- Add logic when stock is implemented -->
                <span class="status-ball green"></span>
                <p>På lager 30+ stk.</p>
            </div>
            <button>Tilføj til kurv</button>
        </div>
    </div>
    {{/each}}
</div>
<div class="show-more-container">
    <button>Vis mere</button>
</div>
{{> footer}}